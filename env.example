# LetZeusPost settings, generated from config/env.ts by `node config/env-example.ts`: do not edit by hand.
# Copy to .env and fill in locally (this template has no leading dot so agents may read it); .env is never
# committed or read by agents. Each process reads only the settings marked with its name (§13, §14) and stops
# at startup when one of them is missing or malformed.

# Database
# Postgres as the app role, under row-level security: postgres://user:password@host:port/database. Read by web, worker.
DATABASE_URL=
# Postgres as the owner role, which the app never holds: postgres://user:password@host:port/database. Read by migrate, seed.
DATABASE_OWNER_URL=

# File store
# The file store's S3 API (SeaweedFS in development): an http:// or https:// URL. Read by web, worker.
STORAGE_ENDPOINT=
# The file store's region: lowercase letters, digits and hyphens, like us-east-1. Read by web, worker.
STORAGE_REGION=
# The private bucket for every file: 3 to 63 lowercase letters, digits, dots or hyphens. Read by web, worker.
STORAGE_BUCKET=
# The file store's access key id: no spaces. Read by web, worker.
STORAGE_ACCESS_KEY_ID=
# The file store's secret key: no spaces. Read by web, worker.
STORAGE_SECRET_ACCESS_KEY=

# Email
# Where emails are sent over SMTP (Mailpit in development): an smtp:// or smtps:// URL with a host. Read by web, worker.
SMTP_URL=
# The address emails are sent from: an email address. Read by web, worker.
EMAIL_FROM=

# Sign-in
# Better Auth's secret for sessions and sign-in tokens: at least 32 characters, no spaces (openssl rand -base64 32). Read by web.
AUTH_SECRET=
# The app's base URL, for sign-in and email links: an http(s) origin, no path or trailing slash. Read by web, worker.
APP_URL=

# Next.js (§14 Deploys)
# Encrypts server-action data; fixed across deploys: a 32-byte key in base64 (openssl rand -base64 32). Read by web.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# The build's id, so open pages survive a deploy: up to 64 letters, digits, dots, underscores or hyphens. Read by web.
NEXT_DEPLOYMENT_ID=
