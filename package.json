{
  "name": "letzeuspost",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^26"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel exec tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm licence-check",
    "check:services": "vitest run --config vitest.services.config.ts && playwright test --pass-with-no-tests",
    "licence-check": "node scripts/licence-check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lzp/auth": "workspace:*",
    "@lzp/config": "workspace:*",
    "@lzp/core": "workspace:*",
    "@lzp/db": "workspace:*",
    "@lzp/storage": "workspace:*",
    "@next/eslint-plugin-next": "16.4.5",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
