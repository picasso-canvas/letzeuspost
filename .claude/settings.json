{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.envrc)",
      "Read(**/.env.staging)",
      "Read(**/.env.preview)",
      "Read(**/.env.prod)",
      "Read(**/.env.dev)",
      "Read(**/.env.ci)",
      "Read(**/.env.secrets)",
      "Agent(daedalus-builder)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(curl * | zsh*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(gh repo delete*)",
      "Bash(gh pr merge*)",
      "Bash(gh api *merge*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  }
}
