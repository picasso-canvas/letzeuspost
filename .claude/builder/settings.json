      "Edit(./tests/lint/**)",
      "Edit(./apps/*/next.config.*)",
      "Edit(./CLAUDE.md)",
      "Edit(./Claude.md)",
      "Edit(./claude.md)",
      "Edit(./CLAUDE.local.md)",
      "Edit(./DESIGN.md)",
      "Edit(./pnpm-workspace.yaml)",
      "Edit(./tsconfig*.json)",
      "Edit(./eslint.config.*)",
      "Edit(./vitest.config.*)",
      "Edit(./playwright.config.*)",
      "Edit(./.prettierrc*)",
      "Edit(./.prettierignore)",
      "Edit(./.gitleaks.toml)",
      "Edit(./.gitleaksignore)",
      "Edit(./.npmrc)",
      "Edit(./.nvmrc)",
      "Edit(./.mcp.json)",
      "Edit(./.gitattributes)",
      "Edit(./.pnpmfile.cjs)",
      "Edit(./osv-scanner.toml)",
      "Edit(./apps/*/CLAUDE.md)",
      "Edit(./apps/*/Claude.md)",
      "Edit(./apps/*/claude.md)",
      "Edit(./apps/*/CLAUDE.local.md)",
      "Edit(./apps/*/DESIGN.md)",
      "Edit(./apps/*/pnpm-workspace.yaml)",
      "Edit(./apps/*/tsconfig*.json)",
      "Edit(./apps/*/eslint.config.*)",
      "Edit(./apps/*/vitest.config.*)",
      "Edit(./apps/*/playwright.config.*)",
      "Edit(./apps/*/.prettierrc*)",
      "Edit(./apps/*/.prettierignore)",
      "Edit(./apps/*/.gitleaks.toml)",
      "Edit(./apps/*/.gitleaksignore)",
      "Edit(./apps/*/.npmrc)",
      "Edit(./apps/*/.nvmrc)",
      "Edit(./apps/*/.mcp.json)",
      "Edit(./apps/*/.gitattributes)",
      "Edit(./apps/*/.pnpmfile.cjs)",
      "Edit(./apps/*/osv-scanner.toml)",
      "Edit(./packages/*/CLAUDE.md)",
      "Edit(./packages/*/Claude.md)",
      "Edit(./packages/*/claude.md)",
      "Edit(./packages/*/CLAUDE.local.md)",
      "Edit(./packages/*/DESIGN.md)",
      "Edit(./packages/*/pnpm-workspace.yaml)",
      "Edit(./packages/*/tsconfig*.json)",
      "Edit(./packages/*/eslint.config.*)",
      "Edit(./packages/*/vitest.config.*)",
      "Edit(./packages/*/playwright.config.*)",
      "Edit(./packages/*/.prettierrc*)",
      "Edit(./packages/*/.prettierignore)",
      "Edit(./packages/*/.gitleaks.toml)",
      "Edit(./packages/*/.gitleaksignore)",
      "Edit(./packages/*/.npmrc)",
      "Edit(./packages/*/.nvmrc)",
      "Edit(./packages/*/.mcp.json)",
      "Edit(./packages/*/.gitattributes)",
      "Edit(./packages/*/.pnpmfile.cjs)",
      "Edit(./packages/*/osv-scanner.toml)",
      "Edit(./config/CLAUDE.md)",
      "Edit(./config/Claude.md)",
      "Edit(./config/claude.md)",
      "Edit(./config/CLAUDE.local.md)",
      "Edit(./config/DESIGN.md)",
      "Edit(./config/pnpm-workspace.yaml)",
      "Edit(./config/tsconfig*.json)",
      "Edit(./config/eslint.config.*)",
      "Edit(./config/vitest.config.*)",
      "Edit(./config/playwright.config.*)",
      "Edit(./config/.prettierrc*)",
      "Edit(./config/.prettierignore)",
      "Edit(./config/.gitleaks.toml)",
      "Edit(./config/.gitleaksignore)",
      "Edit(./config/.npmrc)",
      "Edit(./config/.nvmrc)",
      "Edit(./config/.mcp.json)",
      "Edit(./config/.gitattributes)",
      "Edit(./config/.pnpmfile.cjs)",
      "Edit(./config/osv-scanner.toml)",
      "Bash(git push*)",
      "Bash(gh)",
      "Bash(gh *)",
      "Bash(security *)",
      "Bash(docker*)",
      "Bash(*docker.sock*)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/letzeuspost-picasso/**)",
      "Read(~/Library/Keychains/**)",
      "Read(~/.aws/**)",
      "Read(~/.docker/**)",
      "WebFetch",
      "WebSearch",
      "Read(~/.letzeuspost/**)",
      "mcp__*",
      "Edit(./.git/hooks/**)",
      "Edit(./.git/config)",
      "Edit(./.git/info/**)"
    ],
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "defaultMode": "dontAsk"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "playwright.azureedge.net",
        "playwright.download.prss.microsoft.com",
        "cdn.playwright.dev",
        "fonts.googleapis.com",
        "fonts.gstatic.com"
      ],
      "allowUnixSockets": [],
      "allowLocalBinding": false
    },
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.config/gh",
        "~/letzeuspost-picasso",
        "~/Library/Keychains",
        "~/.aws",
        "~/.docker",
        "~/.letzeuspost",
        "~/.claude/projects",
        "~/Developer/picasso/letzeuspost",
        "~/Developer/picasso/letzeuspost-wt",
        "./.env*",
        "./**/.env*"
      ],
      "denyWrite": [
        "./.github",
        "./.claude",
        "./scripts",
        "./docs/plan",
        "./.husky",
        "./.vscode",
        "./tests/visual/approved",
        "./tests/golden",
        "./tests/lint",
        "./apps/*/next.config.*",
        "./.git/hooks",
        "./.git/config",
        "./.git/info",
        "./CLAUDE.md",
        "./Claude.md",
        "./claude.md",
        "./CLAUDE.local.md",
        "./DESIGN.md",
        "./pnpm-workspace.yaml",
        "./tsconfig*.json",
        "./eslint.config.*",
        "./vitest.config.*",
        "./playwright.config.*",
        "./.prettierrc*",
        "./.prettierignore",
        "./.gitleaks.toml",
        "./.gitleaksignore",
        "./.npmrc",
        "./.nvmrc",
        "./.mcp.json",
        "./.gitattributes",
        "./.pnpmfile.cjs",
        "./osv-scanner.toml",
        "./apps/*/CLAUDE.md",
        "./apps/*/Claude.md",
        "./apps/*/claude.md",
        "./apps/*/CLAUDE.local.md",
        "./apps/*/DESIGN.md",
        "./apps/*/pnpm-workspace.yaml",
        "./apps/*/tsconfig*.json",
        "./apps/*/eslint.config.*",
        "./apps/*/vitest.config.*",
        "./apps/*/playwright.config.*",
        "./apps/*/.prettierrc*",
        "./apps/*/.prettierignore",
        "./apps/*/.gitleaks.toml",
        "./apps/*/.gitleaksignore",
        "./apps/*/.npmrc",
        "./apps/*/.nvmrc",
        "./apps/*/.mcp.json",
        "./apps/*/.gitattributes",
        "./apps/*/.pnpmfile.cjs",
        "./apps/*/osv-scanner.toml",
        "./packages/*/CLAUDE.md",
        "./packages/*/Claude.md",
        "./packages/*/claude.md",
        "./packages/*/CLAUDE.local.md",
        "./packages/*/DESIGN.md",
        "./packages/*/pnpm-workspace.yaml",
        "./packages/*/tsconfig*.json",
        "./packages/*/eslint.config.*",
        "./packages/*/vitest.config.*",
        "./packages/*/playwright.config.*",
        "./packages/*/.prettierrc*",
        "./packages/*/.prettierignore",
        "./packages/*/.gitleaks.toml",
        "./packages/*/.gitleaksignore",
        "./packages/*/.npmrc",
        "./packages/*/.nvmrc",
        "./packages/*/.mcp.json",
        "./packages/*/.gitattributes",
        "./packages/*/.pnpmfile.cjs",
        "./packages/*/osv-scanner.toml",
        "./config/CLAUDE.md",
        "./config/Claude.md",
        "./config/claude.md",
        "./config/CLAUDE.local.md",
        "./config/DESIGN.md",
        "./config/pnpm-workspace.yaml",
        "./config/tsconfig*.json",
        "./config/eslint.config.*",
        "./config/vitest.config.*",
        "./config/playwright.config.*",
        "./config/.prettierrc*",
        "./config/.prettierignore",
        "./config/.gitleaks.toml",
        "./config/.gitleaksignore",
        "./config/.npmrc",
        "./config/.nvmrc",
        "./config/.mcp.json",
        "./config/.gitattributes",
        "./config/.pnpmfile.cjs",
        "./config/osv-scanner.toml"
      ],
      "allowWrite": [
        "/private/tmp/pnpm-store-operation-locks-502",
        "/private/tmp/pnpm-dir-locks-502",
        "/tmp/pnpm-store-operation-locks-502",
        "/tmp/pnpm-dir-locks-502"
      ]
    }
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$LZP_HARNESS_DIR/.claude/hooks/session-start.ts\" --builder",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$LZP_HARNESS_DIR/.claude/hooks/pre-tool-use.ts\" --builder",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$LZP_HARNESS_DIR/.claude/hooks/post-tool-use.ts\" --builder",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$LZP_HARNESS_DIR/.claude/hooks/stop.ts\" --builder",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$LZP_HARNESS_DIR/.claude/hooks/stop.ts\" --builder",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
