{
  "name": "@lzp/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth.ts"
  },
  "dependencies": {
    "@lzp/config": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "pg-boss": "12.38.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate --dialect postgresql --schema ./src/schema.ts --out ./migrations",
    "migrate": "node src/bin/migrate.ts",
    "seed:studio": "node src/seed/studio.ts",
    "seed:dev": "node src/seed/dev.ts"
  }
}
